$(function () {

  // Specific handler for the Login Form
  $('#login-form').on('submit', function(e) {
    e.preventDefault();
    const form = $(this);
    const errorDiv = $('#login-error');
    const submitBtn = form.find('button[type="submit"]');
    const originalBtnText = submitBtn.html();

    // Hide previous errors and show loader
    errorDiv.hide();
    submitBtn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Logging in...');
    submitBtn.prop('disabled', true);

    $.ajax({
      url: form.attr('action'),
      type: 'POST',
      data: form.serialize(),
      dataType: 'json',
      success: function(response) {
        if (response.status === 'success') {
          window.location.href = response.redirect;
        } else {
          // This case might not be hit if server sends proper error codes, but good for fallback
          errorDiv.text(response.message || 'An unexpected error occurred.').show();
        }
      },
      error: function(jqXHR) {
        // Handle server-side validation errors and other issues
        let errorMessage = 'An unknown error occurred.';
        if (jqXHR.responseJSON && jqXHR.responseJSON.message) {
          errorMessage = jqXHR.responseJSON.message;
        }
        errorDiv.text(errorMessage).show();
      },
      complete: function() {
        // Restore button
        submitBtn.html(originalBtnText);
        submitBtn.prop('disabled', false);
      }
    });
  });

  // Specific handler for the Add Comment Form\n  $(\'#add-comment-form\').on(\'submit\', function(e) {\n    e.preventDefault();\n    const form = $(this);\n    const errorDiv = $(\'#comment-error\');\n    const submitBtn = form.find(\'button[type=\"submit\"]\');\n    const originalBtnText = submitBtn.html();\n    const commentsList = $(\'#comments-list\');\n    const textarea = form.find(\'textarea\');\n\n    // Hide previous errors and show loader\n    errorDiv.hide();\n    submitBtn.html(\'<span class=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\"></span> Adding...\');\n    submitBtn.prop(\'disabled\', true);\n\n    $.ajax({\n      url: form.attr(\'action\'),\n      type: \'POST\',\n      data: form.serialize(),\n      dataType: \'json\',\n      success: function(response) {\n        if (response.status === \'success\' && response.comment) {\n          // Clear the \"no comments\" message if it exists\n          commentsList.find(\'.alert-info\').remove();\n          \n          // Make sure the list-group exists\n          if(commentsList.find(\'.list-group\').length === 0){\n             commentsList.html(\'<div class=\"list-group\"></div>\');\n          }\n\n          // Create new comment HTML\n          const newCommentHtml = `\n            <div class=\"list-group-item\">\n              <div class=\"d-flex w-100 justify-content-between\">\n                <h5 class=\"mb-1\">${escapeHtml(response.comment.user_name)}</h5>\n                <small>${escapeHtml(response.comment.created_at)}</small>\n              </div>\n              <p class=\"mb-1\">${escapeHtml(response.comment.content)}</p>\n            </div>\n          `;\n          \n          // Append to the list and clear the form\n          commentsList.find(\'.list-group\').append(newCommentHtml);\n          textarea.val(\'\');\n        }\n      },\n      error: function(jqXHR) {\n        let errorMessage = \'An unknown error occurred.\';\n        if (jqXHR.responseJSON && jqXHR.responseJSON.message) {\n          errorMessage = jqXHR.responseJSON.message;\n        }\n        errorDiv.text(errorMessage).show();\n      },\n      complete: function() {\n        submitBtn.html(originalBtnText);\n        submitBtn.prop(\'disabled\', false);\n      }\n    });\n  });\n\n  // Handle loading task details into modal\n  $(\'#taskDetailsModal\').on(\'show.bs.modal\', function (event) {\n    const button = $(event.relatedTarget); // Button that triggered the modal\n    const taskId = button.data(\'task-id\'); // Extract info from data-* attributes\n    const modalBody = $(this).find(\'#task-details-modal-content\');\n\n    // Clear previous content and show a loader\n    modalBody.html(\'<div class=\"d-flex justify-content-center py-5\"><div class=\"spinner-border\" role=\"status\"><span class=\"visually-hidden\">Loading...</span></div></div>\');\n    \n    $.ajax({\n      url: `controllers/task_controller.php?action=get_task_details_html&task_id=${taskId}`,\n      type: \'GET\',\n      success: function(htmlResponse) {\n        modalBody.html(htmlResponse);\n        // Re-attach event listener for the new comment form inside the modal\n        $(\'#add-comment-form-modal\').off(\'submit\').on(\'submit\', function(e) {\n          e.preventDefault();\n          const form = $(this);\n          const currentTaskId = form.data(\'task-id\'); // Get task ID from the modal\'s form\n          const errorDiv = $(\`#comment-error-modal-${currentTaskId}\`);\n          const submitBtn = form.find(\'button[type=\"submit\"]\');\n          const originalBtnText = submitBtn.html();\n          const commentsList = $(\`#comments-list-modal-${currentTaskId}\`);\n          const textarea = form.find(\'textarea\');\n\n          errorDiv.hide();\n          submitBtn.html(\'<span class=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\"></span> Adding...\');\n          submitBtn.prop(\'disabled\', true);\n\n          $.ajax({\n            url: form.attr(\'action\'),\n            type: \'POST\',\n            data: form.serialize(),\n            dataType: \'json\',\n            success: function(response) {\n              if (response.status === \'success\' && response.comment) {\n                commentsList.find(\'.alert-info\').remove();\n                if(commentsList.find(\'.list-group\').length === 0){\n                   commentsList.html(\'<div class=\"list-group\"></div>\');\n                }\n                const newCommentHtml = `\n                  <div class=\"list-group-item list-group-item-action flex-column align-items-start\">\n                    <div class=\"d-flex w-100 justify-content-between\">\n                      <h6 class=\"mb-1\"><strong>${escapeHtml(response.comment.user_name)}</strong></h6>\n                      <small>${escapeHtml(response.comment.created_at)}</small>\n                    </div>\n                    <p class=\"mb-1\"><em>${escapeHtml(response.comment.content)}</em></p>\n                    <div class=\"d-flex justify-content-end mt-2\">\n                        <button class=\"btn btn-sm btn-outline-warning me-2\" data-bs-toggle=\"modal\" data-bs-target=\"#editCommentModalInModal-${response.comment.id}\">Edit</button>\n                        <form method=\"POST\" action=\"<?= Config::getBaseUrl() ?>controllers/task_controller.php\" class=\"d-inline\" onsubmit=\"return confirm(\'Delete comment?\');\">\n                            <input type=\"hidden\" name=\"action\" value=\"delete_comment\">\n                            <input type=\"hidden\" name=\"comment_id\" value=\"${response.comment.id}\">\n                            <button type=\"submit\" class=\"btn btn-sm btn-outline-danger\">Delete</button>\n                        </form>\n                    </div>\n                  </div>\n                `;\n                commentsList.find(\'.list-group\').append(newCommentHtml);\n                textarea.val(\'\');\n              }\n            },\n            error: function(jqXHR) {\n              let errorMessage = \'An unknown error occurred.\';\n              if (jqXHR.responseJSON && jqXHR.responseJSON.message) {\n                errorMessage = jqXHR.responseJSON.message;\n              }\n              errorDiv.text(errorMessage).show();\n            },\n            complete: function() {\n              submitBtn.html(originalBtnText);\n              submitBtn.prop(\'disabled\', false);\n            }\n          });\n        });\n      },\n      error: function(jqXHR) {\n        modalBody.html(\'<div class=\"alert alert-danger\">Failed to load task details.</div>\');\n      }\n    });\n  });\n\n  // Kanban Board Drag and Drop Handler\n  const kanbanColumns = document.querySelectorAll(\'.kanban-cards\');\n  if (kanbanColumns.length > 0) {\n    kanbanColumns.forEach(column => {\n      new Sortable(column, {\n        group: \'kanban\', // set both lists to same group\n        animation: 150,\n        ghostClass: \'sortable-ghost\',\n        onEnd: function (evt) {\n          const itemEl = evt.item; // dragged HTMLElement\n          const toColumn = evt.to;   // target list\n          \n          const taskId = itemEl.dataset.taskId;\n          const newStatus = toColumn.parentElement.dataset.status;\n          const controllerUrl = \'controllers/task_controller.php\'; \n\n          // Show a subtle loading indicator on the card\n          itemEl.style.opacity = \'0.5\';\n\n          $.post(controllerUrl, {\n              action: \'change_status\',\n              task_id: taskId,\n              status: newStatus\n            },\n            function(response) {\n              if (response.status === \'success\') {\n                showToast(\'success\', response.message || \'Status updated!\');\n              } else {\n                showToast(\'danger\', response.message || \'Update failed.\');\n                // Optional: move the card back if the update fails\n                // evt.from.appendChild(itemEl); \n              }\n            },\n            \'json\'\n          ).fail(function(jqXHR) {\n             let errorMsg = \'Request failed.\';\n             if (jqXHR.responseJSON && jqXHR.responseJSON.message) {\n                 errorMsg = jqXHR.responseJSON.message;\n             }\n             showToast(\'danger\', errorMsg);\n             // Optional: move the card back\n             // evt.from.appendChild(itemEl);\n          }).always(function() {\n             // Restore card opacity\n             itemEl.style.opacity = \'1\';\n          });\n        }\n      });\n    });\n  }\n\n  // Helper to escape HTML to prevent XSS\n  function escapeHtml(text) {
    var map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
  }

  // AJAX Form Submit Handler
  $("form.ajax-form").on("submit", function (e) {
    e.preventDefault();
    const form = $(this);
    const action = form.attr("action");
    const data = form.serialize();
    const submitBtn = form.find('button[type="submit"]');
    const originalBtnText = submitBtn.text();

    // Show loader
    submitBtn.html(
      '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...'
    );
    submitBtn.prop("disabled", true);

    $.post(
      action,
      data,
      function (response) {
        submitBtn.html(originalBtnText);
        submitBtn.prop("disabled", false);

        if (response.success) {
          // Show success toast
          showToast("success", response.message || "Success!");

          // Optional: Reload specific parts, e.g., comments
          if (form.data("reload")) {
            const reloadSelector = form.data("reload");
            // Use $.get to fetch the content and replace the target's HTML
            $.get(window.location.href, function (htmlResponse) {
              const newContent = $(htmlResponse).find(reloadSelector).html();
              $(reloadSelector).html(newContent);
            }).fail(function () {
              showToast("danger", "Failed to reload content.");
            });
          } else {
            // Or reload page if needed
            location.reload();
          }
        } else {
          // Show error toast
          showToast("danger", response.message || "Error occurred.");
        }
      },
      "json"
    ).catch(function () {
      submitBtn.html(originalBtnText);
      submitBtn.prop("disabled", false);
      showToast("danger", "Request failed.");
    });
  });

  // Function to show Bootstrap toast
  function showToast(type, message) {
    const toastHtml = `
            <div class="toast align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;
    let toastContainer = $(".toast-container");
    if (toastContainer.length === 0) {
      $("body").append(
        '<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>'
      );
      toastContainer = $(".toast-container");
    }
    toastContainer.append(toastHtml);
    const toastEl = toastContainer.find(".toast").last();
    const toast = new bootstrap.Toast(toastEl);
    toast.show();
    toastEl.on("hidden.bs.toast", function () {
      $(this).remove();
    });
  }

  // Example: Client-side validation (add to forms as needed)
  // $('form').on('submit', function() {
  //     // Custom validations here
  // });
});
